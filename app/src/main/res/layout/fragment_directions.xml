<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="72dp"
    android:paddingBottom="70dp"
    android:fitsSystemWindows="true"
    tools:context=".ui.directions.DirectionsFragment">


    <!-- 지도 배경 -->
    <com.naver.maps.map.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="50dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_panel_bg"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 경로 A, B: 세로로 정렬 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/routeA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="경로 A"
                android:textSize="16sp"
                android:textColor="#000"
                android:inputType="text"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerResultsA"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/routeA"
                app:layout_constraintStart_toStartOf="@id/routeA"
                app:layout_constraintEnd_toEndOf="@id/routeA"/>

            <EditText
                android:id="@+id/routeB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="경로 B"
                android:textSize="16sp"
                android:textColor="#000"
                android:inputType="text" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerResultsB"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/routeB"
                app:layout_constraintStart_toStartOf="@id/routeB"
                app:layout_constraintEnd_toEndOf="@id/routeB"/>
        </LinearLayout>

        <!-- 검색 버튼: 세로 중앙 -->
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="검색"
            android:textSize="16sp"
            android:backgroundTint="#216AF2"
            android:textColor="#FFF"
            android:elevation="6dp"
            android:layout_marginStart="16dp" />
    </LinearLayout>


    <!-- 하단 상세 경로 버튼 -->
    <Button
        android:id="@+id/btnShowDetail"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="상세 경로 보기"
        android:textSize="16sp"
        android:backgroundTint="#216AF2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="54dp" />


</androidx.constraintlayout.widget.ConstraintLayout>
