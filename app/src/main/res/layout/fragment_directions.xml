<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="72dp"
    android:paddingBottom="70dp"
    android:fitsSystemWindows="true"
    tools:context=".ui.directions.DirectionsFragment">


    <!-- 지도 배경 -->
    <com.naver.maps.map.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 상단 경로 선택 패널 -->
    <LinearLayout
        android:id="@+id/route_panel"
        android:orientation="vertical"
        android:background="@drawable/rounded_panel_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/routeA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="경로 A"
            android:textSize="20sp"
            android:textColor="#000" />

        <EditText
            android:id="@+id/routeB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="경로 B"
            android:textSize="20sp"
            android:textColor="#000" />
    </LinearLayout>

    <!-- 하단 상세 경로 버튼 -->
    <Button
        android:id="@+id/btnShowDetail"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="상세 경로 보기"
        android:textSize="18sp"
        android:backgroundTint="#216AF2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

    <!-- 오른쪽 하단 검색 버튼 -->
    <Button
        android:id="@+id/btnSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="검색"
        android:backgroundTint="#216AF2"
        android:textColor="#FFF"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="32dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
